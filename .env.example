# Copy to .env.local. The app refuses to boot without NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid
NEXT_PUBLIC_APP_NAME=Saraf

# Cloudflare Turnstile site key. Optional: leave empty and the sign-in form
# shows no challenge and sends no token. A site key is public — the secret half
# belongs to the backend and must never appear here.
#
# Cloudflare publishes test site keys for local work: 1x00000000000000000000AA
# always passes, 2x00000000000000000000AB always fails. Both are public.
# The matching Turnstile *secret* key belongs to the backend that verifies the
# token. It must never appear in this repository — not here, not in .env.local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ — these must not reach the browser.
# Name of the httpOnly cookie the backend issues on login.
AUTH_COOKIE_NAME=saraf_session

# --- Observability (all optional; every one is inlined into the client bundle
# --- at build time, so none of them may ever hold a secret) ---
#
# Stamped by CI. Locally they are absent and the footer reads "0.0.0-dev",
# which is the correct answer for a build nobody can reproduce from a tag.
# NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_BUILD_SHA=
# NEXT_PUBLIC_BUILD_TIME=
#
# Free text: production, staging, uat, or whatever the infrastructure calls it.
# NEXT_PUBLIC_ENVIRONMENT=development
#
# Comma-separated. Unknown names are ignored and warned about in development;
# an absent flag is off, so a typo can only ever turn a feature off.
# Known flags: telemetry, advancedAnalytics
# NEXT_PUBLIC_FEATURE_FLAGS=
